<?xml version="1.0"?>
<robot name="simple_kettle">

  <!-- Single-link kettle, approximated with primitive shapes -->

  <link name="kettle_link">

    <!-- Inertial properties (rough approximation) -->
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/> <!-- Center halfway up body -->
      <mass value="0.8"/> <!-- 0.8 kg -->
      <inertia 
        ixx="0.00288" ixy="0.0" ixz="0.0"
        iyy="0.00288" iyz="0.0"
        izz="0.00144"/>
    </inertial>

    <!-- Visual: main body -->
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.06"/>
      </geometry>
      <material name="kettle_body">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>

    <!-- Visual: lid -->
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.055"/>
      </geometry>
      <material name="kettle_lid">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <!-- Visual: handle (box on the side) -->
    <visual>
      <origin xyz="-0.075 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.12 0.12"/>
      </geometry>
      <material name="kettle_handle">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <!-- Visual: spout (small tilted cylinder) -->
    <visual>
      <!-- Slightly up and to the front, tilted down a bit -->
      <origin xyz="0.065 0 0.12" rpy="0 0.5 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.012"/>
      </geometry>
      <material name="kettle_spout">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>

    <!-- Collision (simplified as just the main body cylinder) -->
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.06"/>
      </geometry>
    </collision>

  </link>

  <!-- Base joint to world (optional, fixed at origin) -->
  <joint name="kettle_base_joint" type="fixed">
    <parent link="world"/>
    <child link="kettle_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>